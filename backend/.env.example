# ResolveAI backend environment
# Copy to `.env` and fill in. NEVER commit the filled file.
# `.env` is gitignored. Every value below is backend-only and must never
# appear in frontend code, in a browser bundle, or in a git commit.

# Server
PORT=5000
NODE_ENV=development

# Supabase (Project Settings -> API)
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security. Backend only. Never ship to a browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- LLM provider chain: tried in order, then a deterministic fallback ---
# Each provider accepts <PROVIDER>_API_KEY plus any number of
# <PROVIDER>_API_KEY_2, _3, ... Extra keys are rotated to on a quota error.

# 1. Google Gemini (primary) - aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# 2. Groq (OpenAI-compatible) - console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# 3. OpenRouter (OpenAI-compatible) - openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# CORS allow-list. Comma-separated, exact origins, no trailing slash.
#
# One deployment can serve both the hosted frontend and a developer running
# locally against it — just list both:
#   FRONTEND_URL=https://your-app.vercel.app,http://localhost:5173
#
# Outside production, http://localhost:5173 is always allowed regardless of
# this value, so a fresh clone works before anything is configured.
FRONTEND_URL=http://localhost:5173
