# ResolveAI backend environment
# Copy to `.env` and fill in. NEVER commit the filled file.
# `.env` is gitignored. Every value below is backend-only and must never
# appear in frontend code, in a browser bundle, or in a git commit.

# Server
PORT=5000
NODE_ENV=development

# Supabase (Project Settings -> API)
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security. Backend only. Never ship to a browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Google Gemini (aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# CORS origin of the deployed frontend (exact origin, no trailing slash)
FRONTEND_URL=http://localhost:5173
