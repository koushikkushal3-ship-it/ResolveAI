# ResolveAI frontend environment
# Copy to `.env` and fill in.
#
# Vite exposes every VITE_* variable to the browser bundle.
# Therefore this file may contain EXACTLY ONE variable, and it must not be secret.
# Never add GEMINI_API_KEY, SUPABASE_SERVICE_ROLE_KEY or JWT_SECRET here.

# Local development, with the backend running on your machine:
VITE_API_URL=http://localhost:5000

# Deployed (set this in the Vercel dashboard, not in a committed file):
# VITE_API_URL=https://resolveai-ukwt.onrender.com
